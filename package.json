    "test": "vitest run",
    "lan": "python3 lagoon-server.py"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.1",
    "@fontsource/lilita-one": "^5.1.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
