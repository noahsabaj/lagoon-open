{
  "name": "lagoon-open",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Motion-controlled 3D arcade tennis on tropical lagoon venues, powered by Three.js and Blender hero assets.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
